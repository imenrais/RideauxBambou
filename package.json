{
  "name": "rideaux-bamboux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "predev": "npm run prisma:generate",
    "prebuild": "npm run prisma:generate",
    "dev": "next dev -p 3000",
    "dev:force": "node scripts/start-dev.js",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "start:next": "next start -p 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=high",
    "security:check": "npm run security:audit",
    "clean": "cross-env rimraf .next out dist",
    "test": "echo \"No tests specified\" && exit 0",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "pre-deploy": "npm run type-check && npm run lint && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.83.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/formidable": "^3.4.6",
    "apexcharts": "^4.7.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.16",
    "next": "^15.5.20",
    "next-auth": "^4.24.11",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.61.1",
    "react-icons": "^5.5.0",
    "tailwindcss": "^3.4.17",
    "zod": "^4.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
