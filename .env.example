# Copy to .env on the Hostinger VPS (never commit real secrets).
# cp .env.example .env

# App
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXTAUTH_URL=https://your-domain.com
APP_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-a-long-random-string

# Database (PostgreSQL on the VPS or managed host)
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/rideaux_bamboux?schema=public

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Cloudinary (product / review images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
