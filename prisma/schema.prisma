generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String      @id @default(cuid())
  firstName          String
  lastName           String
  name               String
  email              String      @unique
  password           String
  role               String      @default("user")
  resetPasswordToken String?
  resetPasswordExpiry DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  orders             Order[]
}

model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            Json
  deliveryFee      Float    @default(0)
  installationFee  Float    @default(0)
  wantsInstallation Boolean @default(true)
  totalAmount      Float
  status           String   @default("pending")
  customerInfo     Json
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Price {
  id          String   @id @default(cuid())
  pricePerM2  Float
  lastUpdated DateTime @default(now())
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InstallationFee {
  id          String   @id @default(cuid())
  fee         Float
  lastUpdated DateTime @default(now())
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeliveryFee {
  id          String   @id @default(cuid())
  state       String   @unique
  stateCode   String   @unique
  fee         Float
  isActive    Boolean  @default(true)
  lastUpdated DateTime @default(now())
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  image     String
  caption   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
