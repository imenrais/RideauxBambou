generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String      @id @default(cuid())
  firstName          String
  lastName           String
  name               String
  email              String      @unique
  password           String
  role               String      @default("user")
  resetPasswordToken String?
  resetPasswordExpiry DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  orders             Order[]
}

model Product {
  id              String   @id @default(cuid())
  name            String   @unique
  image           String
  isActive        Boolean  @default(true)
  isAvailable     Boolean  @default(true)
  supportsPanneau Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Order {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            Json
  deliveryFee      Float    @default(0)
  installationFee  Float    @default(0)
  wantsInstallation Boolean @default(true)
  totalAmount      Float
  status           String   @default("pending")
  customerInfo     Json
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Price {
  id                String   @id @default(cuid())
  pricePerM2        Float
  salePricePerM2    Float?
  isSaleActive      Boolean  @default(false)
  panneauPrice100cm Float    @default(160)
  panneauPrice130cm Float    @default(180)
  lastUpdated       DateTime @default(now())
  updatedBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InstallationFee {
  id          String   @id @default(cuid())
  fee         Float
  lastUpdated DateTime @default(now())
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeliveryFee {
  id          String   @id @default(cuid())
  state       String   @unique
  stateCode   String   @unique
  fee         Float
  isActive    Boolean  @default(true)
  lastUpdated DateTime @default(now())
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeliveryFeeSettings {
  id                   String   @id @default("default")
  isFreeDeliveryActive Boolean  @default(false)
  feeBackup            Json?
  lastUpdated          DateTime @default(now())
  updatedBy            String   @default("system")
}

model Review {
  id        String   @id @default(cuid())
  image     String
  caption   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PanneauSettings {
  id            String   @id @default("default")
  fixedHeightCm Int      @default(220)
  isSaleActive  Boolean  @default(false)
  updatedBy     String   @default("system")
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PanneauWidth {
  id        String   @id @default(cuid())
  widthCm   Int      @unique
  label     String?
  price     Float
  salePrice Float?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("newsletter")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Shared across Node/PM2 processes — rate limits and auth lockouts.
model RateLimitEntry {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model AuthLockout {
  key         String    @id
  failedCount Int       @default(0)
  lockUntil   DateTime?
  updatedAt   DateTime  @updatedAt
}
